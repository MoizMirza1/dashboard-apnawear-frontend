+.purchase-item-row { display: grid; grid-template-columns: 34px minmax(230px, 1.5fr) minmax(95px, .45fr) minmax(130px, .55fr) minmax(145px, .55fr) auto; gap: 12px; align-items: end; padding: 16px; border: 1px solid var(--line); border-radius: 14px; background: #fafafa; }
+.purchase-line-number { align-self: center; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--brand); color: white; font-size: 12px; font-weight: 900; }
+.purchase-line-total { display: grid; gap: 6px; align-self: center; }
+.purchase-line-total span { color: var(--muted); font-size: 11px; }
+.purchase-line-total strong { font-size: 15px; }
+.remove-line-button { align-self: center; border: 0; background: transparent; color: var(--danger); padding: 8px 0; font-size: 12px; font-weight: 800; }
+.remove-line-button:disabled { color: #b8bdc5; cursor: not-allowed; }
+.purchase-history-table { min-width: 1050px; }
