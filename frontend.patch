+  .section-heading-row .compact-button { width: 100%; }
+  .purchase-item-row { grid-template-columns: 30px 1fr; }
+  .purchase-variant-field, .purchase-line-total { grid-column: 1 / -1; }
+  .purchase-item-row > .field:not(.purchase-variant-field) { grid-column: 2; }
