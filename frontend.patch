+.purchase-history-items > div { padding-bottom: 9px; border-bottom: 1px solid var(--line); }
+.purchase-history-items > div:last-child { padding-bottom: 0; border-bottom: 0; }
+.purchase-history-items strong, .purchase-history-items span { display: block; }
+.purchase-history-items span { margin-top: 4px; color: var(--muted); font-size: 11px; line-height: 1.45; }
